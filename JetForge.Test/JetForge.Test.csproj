    <Compile Include="..\KSP\Source\Core\Arch\CompressorChart.cs" Link="Core\Arch\CompressorChart.cs" />
    <Compile Include="..\KSP\Source\Core\Arch\RefreshPlan.cs" Link="Core\Arch\RefreshPlan.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeProfile.cs" Link="Core\Intake\IntakeProfile.cs" />
    <!-- 型线的三个 partial：预设轮廓 / 镜像 / 量出来的几何。逐个列，没有通配。 -->
    <Compile Include="..\KSP\Source\Core\Intake\IntakeProfile.Presets.cs" Link="Core\Intake\IntakeProfile.Presets.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeProfile.Mirror.cs" Link="Core\Intake\IntakeProfile.Mirror.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeProfile.Geometry.cs" Link="Core\Intake\IntakeProfile.Geometry.cs" />
    <Compile Include="..\KSP\Source\Core\FuelSchedule.cs" Link="Core\FuelSchedule.cs" />
    <Compile Include="..\KSP\Source\Core\FuelLoop.cs" Link="Core\FuelLoop.cs" />
    <!-- 高空再起动窗口：熄火之后"还能不能点着"的判据，纯 Core，进回归。 -->
    <Compile Include="..\KSP\Source\Core\Relight.cs" Link="Core\Relight.cs" />
    <!-- 齿轮箱柔度：扭角与本体扭振，靠纯几何与扭转刚度算，不碰气路，进回归。 -->
    <Compile Include="..\KSP\Source\Core\Arch\Torsion.cs" Link="Core\Arch\Torsion.cs" />
    <!-- 进气道子系统：独立的性能求解器，不依赖 Cycle 的任何中间量。 -->
    <Compile Include="..\KSP\Source\Core\Intake\IntakeSolver.cs" Link="Core\Intake\IntakeSolver.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeGeometry.cs" Link="Core\Intake\IntakeGeometry.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeSpecCodec.cs" Link="Core\Intake\IntakeSpecCodec.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\IntakeInstall.cs" Link="Core\Intake\IntakeInstall.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\StockIntakeBridge.cs" Link="Core\Intake\StockIntakeBridge.cs" />
    <Compile Include="..\KSP\Source\Core\Intake\Shock.cs" Link="Core\Intake\Shock.cs" />
    <!-- 运行时状态审计：核对"结果自己跟自己对得上吗"，不重算物理。 -->
