    <Compile Include="..\KSP\Source\Core\DesignVerdict.cs" Link="Core\DesignVerdict.cs" />
    <Compile Include="..\KSP\Source\Core\ModelLedger.cs" Link="Core\ModelLedger.cs" />
    <Compile Include="..\KSP\Source\Core\Loc.cs" Link="Core\Loc.cs" />
