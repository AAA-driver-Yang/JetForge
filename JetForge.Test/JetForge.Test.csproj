    <Compile Include="..\KSP\Source\Core\NozzleSchedule.cs" Link="Core\NozzleSchedule.cs" />
    <Compile Include="..\KSP\Source\Core\FanMap.cs" Link="Core\FanMap.cs" />
    <Compile Include="..\KSP\Source\Core\CompressorMap.cs" Link="Core\CompressorMap.cs" />
    <Compile Include="..\KSP\Source\Core\Defects.cs" Link="Core\Defects.cs" />
    <Compile Include="..\KSP\Source\Core\Surge.cs" Link="Core\Surge.cs" />
    <Compile Include="..\KSP\Source\Core\Filter.cs" Link="Core\Filter.cs" />
