    <Compile Include="..\KSP\Source\Core\HintIndex.cs" Link="Core\HintIndex.cs" />
    <Compile Include="..\KSP\Source\Core\Cycle.cs" Link="Core\Cycle.cs" />
    <Compile Include="..\KSP\Source\Core\OffDesign.cs" Link="Core\OffDesign.cs" />
    <Compile Include="..\KSP\Source\Core\OffDesign.Shaft.cs" Link="Core\OffDesign.Shaft.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.cs" Link="Core\Criteria.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Compressor.cs" Link="Core\Criteria.Compressor.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Controls.cs" Link="Core\Criteria.Controls.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Intake.cs" Link="Core\Criteria.Intake.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Nozzle.cs" Link="Core\Criteria.Nozzle.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Shaft.cs" Link="Core\Criteria.Shaft.cs" />
    <Compile Include="..\KSP\Source\Core\Criteria.Thermal.cs" Link="Core\Criteria.Thermal.cs" />
    <Compile Include="..\KSP\Source\Core\StageLoad.cs" Link="Core\StageLoad.cs" />
    <Compile Include="..\KSP\Source\Core\PerformanceGrid.cs" Link="Core\PerformanceGrid.cs" />
    <Compile Include="..\KSP\Source\Core\Simple.cs" Link="Core\Simple.cs" />
  <Compile Include="..\KSP\Source\Core\MassCost.cs" Link="Core\MassCost.cs" />
    <Compile Include="..\KSP\Source\Core\PlumeMath.cs" Link="Core\PlumeMath.cs" />
    <Compile Include="..\KSP\Source\Core\GridFactory.cs" Link="Core\GridFactory.cs" />
    <Compile Include="..\KSP\Source\Core\DesignSignature.cs" Link="Core\DesignSignature.cs" />
    <Compile Include="..\KSP\Source\Core\UserLibrary.cs" Link="Core\UserLibrary.cs" />
    <!-- 两台设计并排比读数：只读设计点与质量/长度估算，不碰 Unity，进回归。 -->
    <Compile Include="..\KSP\Source\Core\DesignCompare.cs" Link="Core\DesignCompare.cs" />
    <Compile Include="..\KSP\Source\Core\Presets.cs" Link="Core\Presets.cs" />
    <Compile Include="..\KSP\Source\Core\Spool.cs" Link="Core\Spool.cs" />
