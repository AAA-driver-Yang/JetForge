    <Compile Include="..\KSP\Source\Core\VectorCommand.cs" Link="Core\VectorCommand.cs" />
    <!-- 飞行链路本身也编进来：抬底→风车→滞后→查表→自持闸→库存桥这一整段
         以前只活在 PartModule 里，命令行一行都跑不了，只能靠实飞验。 -->
    <Compile Include="..\KSP\Source\Core\EngineGuard.cs" Link="Core\EngineGuard.cs" />
    <Compile Include="..\KSP\Source\Core\FlightStep.cs" Link="Core\FlightStep.cs" />
    <Compile Include="..\KSP\Source\Core\CycleSampler.cs" Link="Core\CycleSampler.cs" />
    <!-- 存档层也一起编进来：它只依赖 ConfigNode，而 ConfigNodeStub.cs 提供了最小实现。
         这样"设计参数存得回来吗"就能在命令行里验，不用进游戏。 -->
    <Compile Include="..\KSP\Source\Core\EngineDesignData.Persistence.cs" Link="Core\EngineDesignData.Persistence.cs" />
    <Compile Include="..\KSP\Source\Core\SimpleDesign.Persistence.cs" Link="Core\SimpleDesign.Persistence.cs" />
    <!-- 架构层：数据契约（GasState/测站）、部件接口、气路模板、轴系、整机网络。
         这一层就是"设计点怎么走"的新骨架，必须和命令行回归一起编，否则
         "逐位相同"这条断言没法验。 -->
