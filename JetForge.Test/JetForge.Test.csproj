<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 本机只装了 net10 的参考包，离线也编得动；net8 会去 nuget 抓 targeting pack 然后失败 -->
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources></RestoreSources>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>JetForge.Test</RootNamespace>
    <AssemblyName>JetForge.Test</AssemblyName>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只包含不依赖 KSP 的物理内核：这样同一份算法能在命令行里跑回归，
         不用启动游戏就能验证 C# 移植是否与 Python 原型一致。 -->
    <Compile Include="..\KSP\Source\Core\Gas.cs" Link="Core\Gas.cs" />
    <Compile Include="..\KSP\Source\Core\TechLevel.cs" Link="Core\TechLevel.cs" />
    <Compile Include="..\KSP\Source\Core\EngineDesignData.cs" Link="Core\EngineDesignData.cs" />
    <Compile Include="..\KSP\Source\Core\EngineGeometry.cs" Link="Core\EngineGeometry.cs" />
    <Compile Include="..\KSP\Source\Core\Intake.cs" Link="Core\Intake.cs" />
